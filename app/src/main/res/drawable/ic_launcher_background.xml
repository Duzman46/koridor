<?xml version="1.0" encoding="utf-8"?>
<!--
  The icon's plate.

  Two passes, because one flat fill at 48px reads as a sticker and one flat gradient reads as
  a wallpaper. The first is jade lit from the upper left, which is where the mark's own
  highlights come from, so the plate and the piece standing on it agree about the light. The
  second is a vignette that pulls the far edges down towards black, which is what makes the
  middle read as raised rather than as the same green everywhere.

  The vignette starts inside the 72dp visible square rather than out at the canvas edge: a
  launcher's mask throws away everything past that, so depth painted in the outer eighteen
  units of the canvas is depth nobody ever sees.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="8"
                android:startY="0"
                android:endX="100"
                android:endY="108"
                android:type="linear">
                <item android:offset="0" android:color="#FF17825F" />
                <item android:offset="0.5" android:color="#FF0A4A36" />
                <item android:offset="1" android:color="#FF061B14" />
            </gradient>
        </aapt:attr>
    </path>

    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:centerX="54"
                android:centerY="54"
                android:gradientRadius="76"
                android:type="radial">
                <item android:offset="0.45" android:color="#00000000" />
                <item android:offset="1" android:color="#4D000000" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
