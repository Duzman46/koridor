<?xml version="1.0" encoding="utf-8"?>
<!--
  The icon's plate.

  A vertical jade gradient rather than a flat fill: a single flat colour at 48px reads as a
  sticker, and the gradient is what gives the mark a light source without any bevel or
  shadow trickery. Deep enough that the mint foreground carries on a white launcher and on
  a black one alike.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr xmlns:aapt="http://schemas.android.com/aapt" name="android:fillColor">
            <gradient
                android:startX="54"
                android:startY="0"
                android:endX="54"
                android:endY="108"
                android:type="linear">
                <item android:offset="0" android:color="#FF0E5C43" />
                <item android:offset="1" android:color="#FF052018" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
