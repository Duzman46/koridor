<?xml version="1.0" encoding="utf-8"?>
<!--
  The same three layers as ic_launcher, because an adaptive icon is already round wherever the
  launcher wants it round — the mask is the launcher's to choose. This file exists only so the
  android:roundIcon in the manifest resolves on the devices that ask for it by name.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@mipmap/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_monochrome" />
</adaptive-icon>
