    <string name="tutorial_step_select_title">Select your pawn</string>
    <string name="tutorial_step_select_message">Tap your blue pawn. The green dots that appear are every square it may move to this turn.</string>
    <string name="tutorial_step_move_title">Make a move</string>
    <string name="tutorial_step_move_message">A pawn moves one square at a time — up, down, left or right, never diagonally. Tap the highlighted square.</string>
    <string name="tutorial_step_jump_title">Jump your rival</string>
    <string name="tutorial_step_jump_message">Standing nose to nose, you may leap over your rival and land on the square behind them. That counts as your move, like any other.</string>
    <string name="tutorial_step_blocked_title">A wall can never trap</string>
    <string name="tutorial_step_blocked_message">Now try to seal your rival in. The rules refuse it — a wall may never take away a player’s last route to their goal, so nobody can be trapped.</string>
    <string name="tutorial_step_win_title">Win the game</string>
    <string name="tutorial_step_win_message">Your goal is the far row; your rival’s is the row you started on. Step onto the last row and the match is yours.</string>
    <string name="tutorial_hint_wrong_move">Not that one. Follow the highlighted hint.</string>

