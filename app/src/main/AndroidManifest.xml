<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!--
      Asked for the first time the player switches notifications on in Settings, never on first
      launch: a permission dialog shown before anything has been offered is a dialog everyone
      denies, and Android only lets you ask twice.
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!--
      VIBRATE was deliberately absent, on the reasoning that the app's only haptic went through
      Compose's LocalHapticFeedback — View.performHapticFeedback, which the system server carries
      out under its own identity and which therefore needs no permission here.

      That was true and it did not work. The platform gates performHapticFeedback on
      Settings.System.haptic_feedback_enabled, the phone-wide *touch feedback* switch, and every
      move in the game was being dropped on any handset where somebody had turned it off. A pawn
      landing is not touch feedback — it is the game reporting what happened, the same category
      as its sounds — so it is driven from the vibrator now, under the app's own switch, and that
      needs the permission.
    -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:name=".GridboundApplication"
        android:allowBackup="true"
        android:appCategory="game"
        android:enableOnBackInvokedCallback="true"
        android:hardwareAccelerated="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.Koridor">
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="${ADMOB_APP_ID}" />
        <!--
            Portrait, and only portrait.

            The board is a square that fills the width, the home screen is a photograph with a
            column of cards under it, and the waiting panel is one tall stack. None of them has
            a landscape design, and none of them needs one: this is a game played on a phone
            held upright, on a board whose two players sit at the top and bottom of it.

            `configChanges` still lists orientation because the flag is about who handles a
            change, not whether one can happen — a foldable, a desk dock or a rotating tablet
            can still hand the activity a new configuration, and this keeps it from being torn
            down and rebuilt mid-match when it does.
        -->
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode|density|fontScale|locale|layoutDirection"
            android:exported="true"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.Koridor">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
